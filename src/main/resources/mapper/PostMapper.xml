<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0/EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.minzzzun.bookdart_be.mapper.PostMapper">

    <!---->
    <select id="detail" parameterType="hashMap" resultType="com.minzzzun.bookdart_be.dto.PostDto$DetailResDto">
        SELECT post.id
             , post.deleted
             , post.created_at as createdAt
             , post.modified_at as modifiedAt
             , post.user_id as userId
             , post.title
             , post.content
             , post.img
        FROM post
        WHERE post.id = #{id}
    </select>

    <!-- 공통 WHERE 절 -->
    <sql id="commonWhere">
        WHERE post.id is not NULL
        <if test = "deleted != null">AND post.deleted = #{deleted}</if>
        <if test="sdate != null and sdate != ''">AND post.created_at >= CONCAT(#{sdate}, ' 00:00:00')</if>
        <if test="fdate != null and fdate != ''">AND CONCAT(#{fdate}, ' 23:59:59') >= post.created_at</if>
    </sql>

    <select id="list" parameterType="hashMap" resultType="com.minzzzun.bookdart_be.dto.PostDto$DetailResDto">
        SELECT post.id
        FROM post
        <include refid="commonWhere"/>
    </select>

    <select id="pagedListCount" parameterType="hashMap" resultType="Integer">
        SELECT count(post.id) as listsize
        FROM post
        <include refid="commonWhere"/>
    </select>
    <select id="pagedList" parameterType="hashMap" resultType="com.minzzzun.bookdart_be.dto.PostDto$DetailResDto">
        SELECT post.id
        FROM post
        <include refid="commonWhere"/>

        <if test = "orderby != null and orderby =='id'">ORDER BY post.id </if>
        <if test = "orderway != null and orderway =='DESC'"> DESC</if>
        <if test = "orderway != null and orderway =='ASC'"> ASC</if>
        LIMIT #{offset}, #{perpage}
    </select>
    <select id="scrollList" parameterType="hashMap" resultType="com.minzzzun.bookdart_be.dto.PostDto$DetailResDto">
        SELECT post.id
        FROM post
        <include refid="commonWhere"/>

        <if test = "orderby != null and orderby =='id'">
            <if test = "orderway != null and orderway =='DESC'">
                <if test = "mark != null and mark !=''">AND #{mark} > post.id </if>
                ORDER BY post.id DESC
            </if>
            <if test = "orderway != null and orderway =='ASC'">
                <if test = "mark != null and mark !=''">AND post.id > #{mark}</if>
                ORDER BY post.id ASC
            </if>
        </if>
            <if test = "orderway != null and orderway =='DESC'">
            </if>
            <if test = "orderway != null and orderway =='ASC'">
            </if>

        LIMIT 0, #{perpage}
    </select>
</mapper>